<% content_for :title, "Blog - Yapai Battery" %>
<% content_for :meta_description, "Explore mobile phone battery manufacturing insights, trends, and guides from Yapai Battery Factory." %>

<% 
  hero_title = if params[:category] == 'enterprise_updates'
    t('posts.enterprise_updates.title')
  elsif params[:category] == 'industry_news'
    t('posts.industry_news.title')
  else
    t('navbar.blog')
  end

  hero_subtitle = if params[:category] == 'enterprise_updates'
    t('posts.enterprise_updates.subtitle')
  elsif params[:category] == 'industry_news'
    t('posts.industry_news.subtitle')
  else
    "News & Insights"
  end

  hero_description = if params[:category] == 'enterprise_updates'
    t('posts.enterprise_updates.description')
  elsif params[:category] == 'industry_news'
    t('posts.industry_news.description')
  else
    "Explore mobile phone battery manufacturing insights, trends, and guides from Yapai Battery Factory."
  end
%>

<!-- Hero -->
<section class="hero-section mb-20">
  <div class="hero-bg-pattern"></div>
  <div class="hero-beam"></div>
  
  <div class="max-w-screen-xl mx-auto px-6 relative z-10 w-full">
    <div class="text-center">
      <div class="hero-badge">
        <div class="hero-badge-dot"></div>
        <span class="hero-badge-text"><%= hero_subtitle %></span>
      </div>
      <h1 class="hero-title">
        <%= hero_title %>
        <span>Yapai Insights</span>
      </h1>
      <div class="hero-divider"></div>
      <p class="hero-subtitle">
        <%= hero_description %>
      </p>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 4rem 2rem;
    background: #0f172a; /* Slate 900 */
    overflow: hidden;
    text-align: center;
  }

  .hero-bg-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size: 30px 30px;
  }

  /* Moving light beam effect */
  .hero-beam {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.03),
      rgba(255, 255, 255, 0.08),
      rgba(255, 255, 255, 0.03),
      transparent
    );
    transform: skewX(-25deg);
    animation: beam-swipe 8s infinite linear;
  }

  @keyframes beam-swipe {
    0% { left: -100%; }
    30% { left: 100%; }
    100% { left: 100%; }
  }

  @keyframes fadeUp {
    from { opacity:0; transform:translateY(20px); }
    to { opacity:1; transform:translateY(0); }
  }
  @keyframes pulse-soft {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 0.7; }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 999px;
    margin-bottom: 1.5rem;
    animation: fadeUp 0.8s ease out;
  }

  .hero-badge-dot {
    width: 6px;
    height: 6px;
    background: var(--color-secondary, #f97316); /* Logo Orange */
    border-radius: 50%;
    box-shadow: 0 0 10px var(--color-secondary, #f97316);
    animation: pulse-soft 2s infinite;
  }

  .hero-badge-text {
    color: rgba(255,255,255,0.8);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .hero-title {
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-primary, #22c55e); /* Yapai Logo Green */
    margin-bottom: 1rem;
    animation: fadeUp 0.8s 0.1s ease out both;
  }

  .hero-title span {
    display: block;
    color: var(--color-secondary, #f97316); /* Yapai Logo Orange */
  }

  .hero-subtitle {
    font-size: 1rem;
    color: #94a3b8; /* Slate 400 */
    line-height: 1.6;
    max-width: 500px;
    margin: 0 auto;
    animation: fadeUp 0.8s 0.2s ease out both;
  }

  .hero-divider {
    width: 40px;
    height: 2px;
    background: rgba(255,255,255,0.2);
    margin: 1.5rem auto;
    border-radius: 1px;
    animation: fadeUp 0.8s 0.3s ease out both;
  }
</style>

<!-- Posts grid -->
<div class="py-20 bg-white">
  <div class="max-w-screen-xl mx-auto px-6">
    <% if @posts.any? %>
      <div class="text-sm text-slate-400 mb-8"><%= @posts.total_count %> <%= @posts.total_count == 1 ? "article" : "articles" %></div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% @posts.each do |post| %>
          <article class="group bg-white rounded-[2rem] border border-slate-100 shadow-sm hover:shadow-xl hover:border-primary/20 transition-all duration-500 overflow-hidden flex flex-col">
            <% if post.cover_image.attached? %>
              <div class="h-52 overflow-hidden bg-slate-100">
                <%= image_tag post.cover_image.variant(:thumb), class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-700", alt: post.title %>
              </div>
            <% else %>
              <div class="h-52 bg-gradient-to-br from-primary/10 to-secondary/10 flex items-center justify-center">
                <svg class="w-16 h-16 text-primary/30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>
              </div>
            <% end %>

            <div class="flex flex-col flex-1 p-7">
              <div class="flex items-center gap-2 mb-4">
                <% if post.category.present? %>
                  <span class="px-2 py-0.5 bg-primary/10 text-primary text-[10px] font-black uppercase tracking-widest rounded"><%= t("posts.#{post.category}.title") %></span>
                  <span class="text-slate-200">|</span>
                <% end %>
                <span class="text-xs font-bold text-slate-400 uppercase tracking-widest"><%= post.published_at&.strftime("%b %d, %Y") %></span>
              </div>
              <h2 class="text-xl font-black text-slate-900 mb-3 leading-snug group-hover:text-primary transition-colors">
                <%= link_to post.title, post_path(post) %>
              </h2>
              <p class="text-slate-500 text-sm leading-relaxed font-medium flex-1 line-clamp-3"><%= post.summary %></p>
              <div class="mt-6">
                <%= link_to post_path(post), class: "inline-flex items-center gap-2 text-primary font-bold text-sm hover:gap-3 transition-all" do %>
                  Read More
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                <% end %>
              </div>
            </div>
          </article>
        <% end %>
      </div>
      <!-- Pagination -->
      <% if @posts.total_pages > 1 %>
        <div class="flex justify-center items-center gap-2 mt-14">
          <% if @posts.prev_page %>
            <%= link_to posts_path(page: @posts.prev_page, category: params[:category]), class: "w-10 h-10 flex items-center justify-center rounded-xl border border-slate-200 text-slate-500 hover:bg-primary hover:text-white hover:border-primary transition-all" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            <% end %>
          <% else %>
            <span class="w-10 h-10 flex items-center justify-center rounded-xl border border-slate-100 text-slate-300 cursor-not-allowed">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            </span>
          <% end %>

          <% (@posts.current_page - 2..@posts.current_page + 2).each do |p| %>
            <% next if p < 1 || p > @posts.total_pages %>
            <% if p == @posts.current_page %>
              <span class="w-10 h-10 flex items-center justify-center rounded-xl bg-primary text-white font-bold text-sm shadow-md shadow-primary/30"><%= p %></span>
            <% else %>
              <%= link_to p, posts_path(page: p, category: params[:category]), class: "w-10 h-10 flex items-center justify-center rounded-xl border border-slate-200 text-slate-600 hover:bg-primary hover:text-white hover:border-primary transition-all font-semibold text-sm" %>
            <% end %>
          <% end %>

          <% if @posts.next_page %>
            <%= link_to posts_path(page: @posts.next_page, category: params[:category]), class: "w-10 h-10 flex items-center justify-center rounded-xl border border-slate-200 text-slate-500 hover:bg-primary hover:text-white hover:border-primary transition-all" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            <% end %>
          <% else %>
            <span class="w-10 h-10 flex items-center justify-center rounded-xl border border-slate-100 text-slate-300 cursor-not-allowed">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </span>
          <% end %>
        </div>
      <% end %>

    <% else %>
      <div class="text-center py-24">
        <svg class="w-20 h-20 text-slate-200 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>
        <p class="text-slate-400 text-lg font-medium">No articles yet. Check back soon!</p>
      </div>
    <% end %>
  </div>
</div>

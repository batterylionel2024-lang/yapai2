<% content_for :admin_title, "合作者管理" %>

<div class="mb-6 flex justify-between items-center">
  <p class="text-slate-600">管理展示在 About Us 页面的合作者 Logo。</p>
  <%= link_to "添加新合作者", new_admin_partner_path, class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors" %>
</div>

<div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
  <table class="min-w-full divide-y divide-slate-100">
    <thead class="bg-slate-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">Logo</th>
        <th class="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">名称</th>
        <th class="px-6 py-3 text-left text-xs font-bold text-slate-500 uppercase tracking-wider">创建时间</th>
        <th class="px-6 py-3 text-right text-xs font-bold text-slate-500 uppercase tracking-wider">操作</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @partners.each do |partner| %>
        <tr class="hover:bg-slate-50 transition-colors">
          <td class="px-6 py-4">
            <% if partner.logo.attached? %>
              <%= image_tag partner.logo, class: "h-10 w-auto object-contain" %>
            <% end %>
          </td>
          <td class="px-6 py-4">
            <div class="font-semibold text-slate-900 text-sm"><%= partner.name %></div>
          </td>
          <td class="px-6 py-4 text-sm text-slate-500">
            <%= partner.created_at.strftime("%Y-%m-%d") %>
          </td>
          <td class="px-6 py-4 text-right space-x-3">
            <div class="flex justify-end space-x-3">
              <%= link_to "编辑", edit_admin_partner_path(partner), class: "text-blue-600 hover:text-blue-800 text-sm font-medium" %>
              <%= button_to "删除", admin_partner_path(partner), method: :delete,
                    form: { data: { turbo_confirm: "确定删除此合作者？" } },
                    class: "text-red-500 hover:text-red-700 text-sm font-medium bg-transparent border-0 cursor-pointer" %>
            </div>
          </td>
        </tr>
      <% end %>
      <% if @partners.empty? %>
        <tr>
          <td colspan="4" class="px-6 py-12 text-center text-slate-400 text-sm">暂无合作者</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

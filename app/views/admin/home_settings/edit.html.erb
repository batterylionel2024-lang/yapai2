<% content_for :admin_title, "首页与工厂管理" %>

<div class="max-w-4xl mx-auto">
  <%= form_with(model: @site_config, url: admin_home_settings_path, method: :patch, class: "space-y-8") do |f| %>
    <% if @site_config.errors.any? %>
      <div class="p-4 mb-6 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
        <ul>
          <% @site_config.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
      <h3 class="text-lg font-medium text-slate-800 mb-6 border-b pb-2">首页 Infrastructure (03 部分)</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div>
          <%= f.label :infra_title, "大标题", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :infra_title, placeholder: "e.g. Production Capacity", class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-primary focus:border-primary" %>
        </div>
        <div>
          <%= f.label :infra_subtitle, "副标题/描述", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :infra_subtitle, class: "w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-primary focus:border-primary" %>
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <% (1..4).each do |i| %>
          <div class="p-4 border border-slate-100 rounded-lg bg-slate-50">
            <h4 class="font-bold mb-3 text-slate-600 text-sm">模块 <%= i %></h4>
            <div class="space-y-3">
              <div>
                <%= f.label "infra_label_#{i}", "标签", class: "block text-xs font-medium text-slate-500 mb-1" %>
                <%= f.text_field "infra_label_#{i}", class: "w-full px-3 py-1.5 border border-slate-300 rounded-lg text-sm focus:ring-primary focus:border-primary" %>
              </div>
              <div>
                <%= f.label "infra_value_#{i}", "数值", class: "block text-xs font-medium text-slate-500 mb-1" %>
                <%= f.text_field "infra_value_#{i}", class: "w-full px-3 py-1.5 border border-slate-300 rounded-lg text-sm focus:ring-primary focus:border-primary" %>
              </div>
              <div>
                <%= f.label "infra_image_#{i}", "图片", class: "block text-xs font-medium text-slate-500 mb-1" %>
                <% if @site_config.send("infra_image_#{i}").attached? %>
                  <%= image_tag @site_config.send("infra_image_#{i}"), class: "h-20 w-32 object-cover rounded mb-2 border" %>
                <% end %>
                <%= f.file_field "infra_image_#{i}", class: "text-xs text-slate-500 file:mr-4 file:py-1 file:px-3 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-primary/10 file:text-primary hover:file:bg-primary/20" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
      <h3 class="text-lg font-medium text-slate-800 mb-6 border-b pb-2">首页 Why Choose Us (05 部分)</h3>
      <div>
        <%= f.label :strength_image, "左侧图片", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <% if @site_config.strength_image.attached? %>
          <div class="mb-4">
            <%= image_tag @site_config.strength_image, class: "max-w-md h-auto rounded-xl shadow-sm border" %>
          </div>
        <% end %>
        <%= f.file_field :strength_image, class: "block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-primary/10 file:text-primary hover:file:bg-primary/20" %>
        <p class="mt-2 text-xs text-slate-400">建议上传大图，将显示在优势模块的左侧。</p>
      </div>
    </div>

    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
      <h3 class="text-lg font-medium text-slate-800 mb-6 border-b pb-2">工厂页面 (Factory) 轮播图</h3>
      <div>
        <%= f.label :factory_images, "上传轮播图片 (可多选)", class: "block text-sm font-medium text-slate-700 mb-2" %>
        
        <% if @site_config.factory_images.attached? %>
          <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 gap-4 mb-4">
            <% @site_config.factory_images.each do |image| %>
              <div class="relative group aspect-video rounded-lg overflow-hidden border border-slate-200">
                <%= image_tag image, class: "w-full h-full object-cover" %>
                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                   <span class="text-[10px] text-white px-2 py-1 bg-black/50 rounded">已上传</span>
                </div>
              </div>
            <% end %>
          </div>
          <p class="text-xs text-amber-600 mb-4 italic">* 重新上传将替换所有现有图片</p>
        <% end %>

        <%= f.file_field :factory_images, multiple: true, class: "block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-primary/10 file:text-primary hover:file:bg-primary/20" %>
        <p class="mt-2 text-xs text-slate-400">建议上传 5 张或更多图片，建议尺寸 800x560px。</p>
      </div>
    </div>

    <div class="flex justify-end pt-4">
      <%= f.submit "保存设置", class: "px-6 py-2 bg-primary text-white font-medium rounded-lg hover:bg-primary/90 transition-colors shadow-sm cursor-pointer" %>
    </div>
  <% end %>
</div>

<% content_for :title, "Yapai Battery Factory - Professional Mobile Phone Battery Manufacturer" %>
<% content_for :meta_description, "Yapai Battery Factory is a professional mobile phone battery manufacturer in Guangdong, China. OEM/ODM replacement batteries for iPhone, Huawei, Xiaomi, and 1,000+ brands." %>
<% content_for :meta_keywords, "mobile phone battery factory, smartphone replacement battery, Yapai Battery, iPhone battery wholesale, OEM battery manufacturer, China battery factory" %>


<section
  id="hero"
  class="relative -mt-20 w-full overflow-hidden"
  style="height: 100svh; min-height: 600px;"
  data-controller="slideshow"
  aria-label="Hero Slideshow"
>

  <%# ── 1. Background Slides ── %>
  <div class="absolute inset-0 z-0">
    <% [1, 2, 3].each_with_index do |n, idx| %>
      <div
        class="absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-0"
        data-slideshow-target="slide"
      >
        <%= image_tag "indexbanner#{n}.webp",
                      class: "w-full h-full object-cover object-center scale-105 transition-transform duration-[5000ms]",
                      alt: "",
                      role: "presentation",
                      loading: idx == 0 ? "eager" : "lazy" %>
      </div>
    <% end %>
  </div>

  <%# ── 2. Overlay Gradients (Improved Contrast) ── %>
  <div class="absolute inset-0 z-10 pointer-events-none">
    <%# Global subtle darkening %>
    <div class="absolute inset-0 bg-black/30"></div>
    <%# Bottom dark gradient for text readability %>
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
    <%# Left side gradient for desktop text focus %>
    <div class="absolute inset-0 hidden lg:block bg-gradient-to-r from-black/60 via-transparent to-transparent"></div>
  </div>

  <%# ── 3. Content ── %>
  <div class="absolute inset-0 z-20 flex flex-col justify-end lg:justify-center">
    <div class="w-full max-w-screen-xl mx-auto px-6 sm:px-12 lg:px-20 pb-24 lg:pb-0">
      
      <% [1, 2, 3].each_with_index do |i, idx| %>
        <div
          class="absolute bottom-24 lg:bottom-auto lg:top-1/2 lg:-translate-y-1/2 
                 max-w-2xl opacity-0 translate-y-8 pointer-events-none
                 transition-all duration-1000 cubic-bezier-narrative"
          data-slideshow-target="content"
        >
          <div class="inline-flex items-center gap-3 mb-6 stagger-1 bg-white/10 backdrop-blur-md px-4 py-1.5 rounded-full border border-white/20 shadow-xl">
            <span class="w-6 h-[2px] bg-primary rounded-full"></span>
            <span class="text-white text-[10px] sm:text-xs font-black tracking-[0.4em] uppercase">
              Leading Energy Solutions
            </span>
          </div>

          <%# Main Title %>
          <h1 class="font-black text-white leading-[1.1] mb-6 drop-shadow-2xl stagger-2"
              style="font-size: clamp(2.25rem, 8vw, 5rem);">
            <%= t("home.index.hero_slides.slide#{i}.title1") %><br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-white to-primary bg-[length:200%_auto] animate-gradient-x">
              <%= t("home.index.hero_slides.slide#{i}.title2") %>
            </span>
          </h1>

          <%# Description %>
          <p class="text-white/80 text-sm sm:text-base lg:text-xl max-w-xl mb-10 leading-relaxed font-medium stagger-3 drop-shadow-md">
            <%= t("home.index.hero_slides.slide#{i}.desc") %>
          </p>

          <%# Actions - Removed as per request %>
        </div>
      <% end %>
    </div>
  </div>

  <%# ── 4. Controls (Bottom Right) ── %>
  <div class="absolute bottom-12 right-6 lg:right-20 z-30 flex items-center gap-2 stagger-4">

    <%# Indicators %>
    <div class="flex items-center gap-4">
      <% 3.times do |n| %>
        <button
          type="button"
          class="group relative h-12 w-1.5 flex items-center justify-center"
          data-action="click->slideshow#goTo"
          data-index="<%= n %>"
          aria-label="Go to slide <%= n + 1 %>"
        >
          <span class="block w-full h-full bg-white/20 rounded-full transition-all duration-700 group-hover:bg-primary/60"
                data-slideshow-target="indicator"></span>
          <%# Hover number effect %>
          <span class="absolute -top-6 text-[10px] font-black text-white opacity-0 group-hover:opacity-100 transition-opacity">0<%= n + 1 %></span>
        </button>
      <% end %>
    </div>
  </div>

</section>

<!-- ===== YAPAI PRODUCT MARQUEE (Anchor & Overlap) ===== -->
<div id="marquee" class="relative z-20 -mt-20 bg-white pt-24 pb-16 overflow-hidden rounded-t-[4rem] shadow-[0_-20px_50px_rgba(0,0,0,0.03)] border-t border-slate-100">
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-px h-24 bg-gradient-to-b from-primary/30 to-transparent"></div>
  <!-- Forward strip -->
  <div class="overflow-hidden mb-4">
    <div class="flex gap-5 w-max" style="animation: yapai-marquee 32s linear infinite;">
      <% if @home_products_1.any? %>
        <% 2.times do %>
          <% @home_products_1.each do |hp| %>
            <div class="relative flex-shrink-0 w-56 h-64 rounded-2xl overflow-hidden group cursor-pointer">
              <% if hp.image.attached? %>
                <%= image_tag hp.image, class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" %>
              <% else %>
                <div class="w-full h-full bg-slate-100 flex items-center justify-center text-slate-300 italic text-xs"><%= hp.title %></div>
              <% end %>
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-100 transition-opacity duration-300 flex items-end p-4">
                <span class="text-white font-bold text-sm tracking-wide"><%= hp.title %></span>
              </div>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <% 2.times do %>
          <% [["iphone.webp","For iPhone Battery"],["vivo.webp","For Vivo Battery"],["oppo.webp","For Oppo Battery"],["huawei.webp","For Huawei Battery"],["xiaomi.webp","For Xiaomi Battery"]].each do |img, label| %>
            <div class="relative flex-shrink-0 w-56 h-64 rounded-2xl overflow-hidden group cursor-pointer">
              <%= image_tag img, class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" %>
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-100 transition-opacity duration-300 flex items-end p-4">
                <span class="text-white font-bold text-sm tracking-wide"><%= label %></span>
              </div>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
  <!-- Reverse strip -->
  <div class="overflow-hidden">
    <div class="flex gap-5 w-max" style="animation: yapai-marquee-rev 32s linear infinite;">
      <% if @home_products_2.any? %>
        <% 2.times do %>
          <% @home_products_2.each do |hp| %>
            <div class="relative flex-shrink-0 w-56 h-64 rounded-2xl overflow-hidden group cursor-pointer">
              <% if hp.image.attached? %>
                <%= image_tag hp.image, class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" %>
              <% else %>
                <div class="w-full h-full bg-slate-100 flex items-center justify-center text-slate-300 italic text-xs"><%= hp.title %></div>
              <% end %>
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-100 transition-opacity duration-300 flex items-end p-4">
                <span class="text-white font-bold text-sm tracking-wide"><%= hp.title %></span>
              </div>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <% 2.times do %>
          <% [["huawei.webp","For Huawei Battery"],["xiaomi.webp","For Xiaomi Battery"],["iphone.webp","For iPhone Battery"],["vivo.webp","For Vivo Battery"],["oppo.webp","For Oppo Battery"]].each do |img, label| %>
            <div class="relative flex-shrink-0 w-56 h-64 rounded-2xl overflow-hidden group cursor-pointer">
              <%= image_tag img, class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" %>
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-100 transition-opacity duration-300 flex items-end p-4">
                <span class="text-white font-bold text-sm tracking-wide"><%= label %></span>
              </div>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<!-- WHO WE ARE Section (Relocated below Product Catalog) -->
<div id="about" class="bg-slate-50 section-py relative overflow-hidden -mt-20 z-20 rounded-t-[4rem] shadow-[0_-30px_60px_rgba(0,0,0,0.02)]">
  <%# Visual Anchor: Connecting Line from above %>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-px h-32 bg-gradient-to-b from-primary/30 to-transparent"></div>

  <div class="narrative-container relative z-10">
    <div class="flex flex-col lg:flex-row gap-16 items-start">
      <div class="w-full reveal-up">
        <div class="text-center mb-6">
           <span class="eyebrow-unified eyebrow-primary">01. Who We Are</span>
        </div>
        <h2 class="h2-unified mb-10 text-center">
          <%= t('home.index.who_we_are_title') %>
        </h2>
        <p class="text-slate-500 text-lg leading-relaxed mb-12 text-center max-w-4xl mx-auto font-medium">
          <%= t('home.index.who_we_are_desc') %>
        </p>
        <div class="grid grid-cols-2 gap-6 max-w-2xl mx-auto">
          <div class="card-narrative p-8 text-center group hover:border-primary/30">
            <div class="text-4xl font-black text-primary mb-2 group-hover:scale-110 transition-transform">20</div>
            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest"><%= t('home.index.years_history') %></div>
          </div>
          <div class="card-narrative p-8 text-center group hover:border-secondary/30">
            <div class="text-4xl font-black text-secondary mb-2 group-hover:scale-110 transition-transform">100%</div>
            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest"><%= t('home.index.oem_odm_capability') %></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ===== FEATURED PRODUCTS GRID (Rhythm Change: Light) ===== -->
<div id="products" class="bg-white section-py relative overflow-hidden -mt-20 z-10 rounded-t-[4rem] shadow-[0_-30px_60px_rgba(0,0,0,0.02)]">
  <%# Narrative Linkage: A subtle line connecting Marquee to Products %>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-px h-full bg-slate-200/50 z-0"></div>
  
  <%# Background guiding line %>
  <div class="absolute top-0 right-0 w-1/3 h-full bg-slate-50 -skew-x-12 translate-x-1/3 z-0 opacity-50"></div>
  
  <div class="narrative-container relative z-10">
    <div class="text-center mb-24 reveal-up">
      <div class="flex justify-center mb-4">
        <span class="eyebrow-unified">02. Hot Selling</span>
      </div>
      <h2 class="h2-unified">Battery Products</h2>
      <div class="w-24 h-1.5 bg-primary mx-auto mt-8 rounded-full"></div>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-10">
      <% if @featured_categories.any? %>
        <% @featured_categories.each_with_index do |category, i| %>
          <%= link_to category_path(category), 
                      class: "reveal-product group relative rounded-[2.5rem] overflow-hidden shadow-md hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 cursor-pointer", 
                      style: "transition-delay: #{i * 80}ms" do %>
            <div class="aspect-[3/4] overflow-hidden bg-white">
              <% if category.image.attached? %>
                <%= image_tag rails_storage_proxy_path(category.image.variant(:featured)), class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" %>
              <% else %>
                <div class="w-full h-full bg-slate-100 flex items-center justify-center text-slate-300 italic text-xs">No Image</div>
              <% end %>
            </div>
            <div class="absolute top-3 left-3">
              <span class="bg-primary text-white text-[10px] font-black uppercase tracking-widest px-2.5 py-1 rounded-full">Featured</span>
            </div>
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent px-5 pb-6 pt-16">
              <p class="text-white font-black text-xl leading-tight drop-shadow-lg"><%= category.name %></p>
              <p class="text-white/75 text-xs font-bold mt-1 uppercase tracking-widest"><%= category.keywords.presence || "Custom · OEM · ODM" %></p>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <% [
          { img: "iphone.webp",    name: "iPhone Battery",           tag: "Best Seller", color: "primary",   fit: "cover" },
          { img: "oppo.webp",      name: "Android Battery",          tag: "Premium",     color: "secondary", fit: "cover" },
          { img: "huawei.webp",    name: "Huawei Battery",           tag: "High Capacity", color: "accent",    fit: "cover" },
          { img: "xiaomi.webp",    name: "Xiaomi Battery",           tag: "New Arrival", color: "primary",   fit: "cover" }
        ].each_with_index do |yapai, i| %>
          <div class="reveal-product group relative rounded-3xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 cursor-pointer" style="transition-delay: <%= i * 80 %>ms">
            <div class="aspect-[3/4] overflow-hidden bg-white">
              <%= image_tag yapai[:img], class: "w-full h-full #{yapai[:fit] == 'contain' ? 'object-contain p-4' : 'object-cover'} group-hover:scale-105 transition-transform duration-700" %>
            </div>
            <div class="absolute top-3 left-3">
              <span class="bg-<%= yapai[:color] %> text-white text-[10px] font-black uppercase tracking-widest px-2.5 py-1 rounded-full"><%= yapai[:tag] %></span>
            </div>
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent px-5 pb-6 pt-16">
              <p class="text-white font-black text-xl leading-tight drop-shadow-lg"><%= yapai[:name] %></p>
              <p class="text-white/75 text-xs font-bold mt-1 uppercase tracking-widest">Custom · OEM · ODM</p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<!-- 2. Production Capacity (Rhythm Change: Heavy) -->
<section id="capacity" class="section-py relative overflow-hidden -mt-16">
  <%# Overlap Transition %>
  <div class="absolute top-0 left-0 w-full h-32 bg-gradient-to-b from-slate-50 to-transparent z-10"></div>
  
  <div class="absolute inset-0 z-0">
    <%= image_tag "factory5.jpg", class: "w-full h-full object-cover grayscale-[0.5] opacity-20", alt: "Production Capacity" %>
    <div class="absolute inset-0 bg-white/95"></div>
  </div>

  <div class="narrative-container relative z-10 text-slate-900">
    <div class="flex flex-col md:flex-row items-end justify-between mb-24 reveal-up">
      <div class="text-left">
        <div class="flex justify-start mb-4">
          <span class="eyebrow-unified eyebrow-primary">03. Infrastructure</span>
        </div>
        <h2 class="h2-unified mb-4"><%= @site_config.infra_title.presence || t('home.customize.production.title') %></h2>
      </div>
      <p class="text-slate-500 max-w-md md:text-right font-medium leading-relaxed border-l-2 border-primary/20 pl-6 md:border-l-0 md:border-r-2 md:pr-6"><%= @site_config.infra_subtitle.presence || t('home.customize.production.subtitle') %></p>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8 mb-16">
      <% [
           { label: @site_config.infra_label_1.presence || t("home.customize.production.items.scale"), value: @site_config.infra_value_1.presence || '10,000㎡', img: (@site_config.infra_image_1.attached? ? @site_config.infra_image_1 : 'factory1.jpg') },
           { label: @site_config.infra_label_2.presence || t("home.customize.production.items.equipment"), value: @site_config.infra_value_2.presence || '50+ Units', img: (@site_config.infra_image_2.attached? ? @site_config.infra_image_2 : 'factory2.jpg') },
           { label: @site_config.infra_label_3.presence || t("home.customize.production.items.team"), value: @site_config.infra_value_3.presence || '200+ People', img: (@site_config.infra_image_3.attached? ? @site_config.infra_image_3 : 'worker2.jpg') },
           { label: @site_config.infra_label_4.presence || t("home.customize.production.items.qc"), value: @site_config.infra_value_4.presence || '100% Passed', img: (@site_config.infra_image_4.attached? ? @site_config.infra_image_4 : 'factory3.jpg') }
         ].each do |stat| %>
        <div class="relative group h-64 overflow-hidden rounded-[2.5rem] shadow-lg">
          <%= image_tag stat[:img], class: "w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" %>
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex flex-col justify-end p-6">
            <span class="text-primary text-2xl font-black mb-1"><%= stat[:value] %></span>
            <span class="text-white/80 text-xs font-bold uppercase tracking-widest"><%= stat[:label] %></span>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>


<!-- Manufacturing Excellence Section (Strength) -->
<div id="excellence" class="bg-slate-50 section-py relative overflow-hidden -mt-20 z-10">
  <%# Guiding SVG Curve (Refined for smoother flow) %>
  <svg class="absolute top-0 left-0 w-full text-white fill-current" viewBox="0 0 1440 160" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
    <path d="M0 0h1440v160C1100 60 700 60 0 160V0z"></path>
  </svg>
  
  <%# Narrative Marker connecting About to Excellence %>
  <div class="absolute top-20 left-1/2 -translate-x-1/2 w-px h-32 bg-slate-200"></div>

  <div class="narrative-container relative z-10 mt-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-center">
      <div class="relative order-2 lg:order-1 reveal-left">
        <% if @site_config.strength_image.attached? %>
          <div class="rounded-[3rem] overflow-hidden shadow-2xl hover:scale-105 transition-transform duration-700 border-4 border-white">
            <%= image_tag @site_config.strength_image, class: "w-full h-full object-cover" %>
          </div>
        <% else %>
          <div class="grid grid-cols-2 gap-8">
            <div class="space-y-8 pt-16">
              <div class="aspect-square rounded-[3rem] overflow-hidden shadow-2xl hover:scale-105 transition-transform duration-700 border-4 border-white">
                <%= image_tag "factory1.jpg", class: "w-full h-full object-cover" %>
              </div>
              <div class="aspect-[4/3] rounded-[3rem] overflow-hidden shadow-2xl hover:scale-105 transition-transform duration-700 border-4 border-white">
                <%= image_tag "factory2.jpg", class: "w-full h-full object-cover" %>
              </div>
            </div>
            <div class="space-y-8">
              <div class="aspect-[3/4] rounded-[3rem] overflow-hidden shadow-2xl hover:scale-105 transition-transform duration-700 border-4 border-white">
                <%= image_tag "factory3.jpg", class: "w-full h-full object-cover" %>
              </div>
              <div class="aspect-square rounded-[3rem] overflow-hidden shadow-2xl hover:scale-105 transition-transform duration-700 border-4 border-white">
                <%= image_tag "factory4.jpg", class: "w-full h-full object-cover" %>
              </div>
            </div>
          </div>
        <% end %>
        <div class="absolute -bottom-10 -left-10 bg-primary p-12 rounded-[3rem] shadow-3xl text-white hidden xl:block -rotate-3 hover:rotate-0 transition-transform duration-500 z-20">
          <div class="text-6xl font-black mb-1">20</div>
          <div class="text-[10px] font-bold uppercase tracking-[0.3em]">Years Of Excellence</div>
        </div>
      </div>
      
      <div class="order-1 lg:order-2 reveal-right">
        <div class="flex justify-start mb-6">
          <span class="eyebrow-unified eyebrow-primary">05. Why Choose Us</span>
        </div>
        <h2 class="h2-unified mb-12">
          <%= t('home.index.strength_title') %>
        </h2>
        
        <div class="space-y-12">
          <% ['no_moq', 'flexible', 'easy_process', 'direct_factory'].each_with_index do |key, idx| %>
            <% color_class = ['text-blue-500', 'text-emerald-500', 'text-amber-500', 'text-blue-500'][idx] %>
            <div class="flex items-start space-x-6 group reveal-up" style="transition-delay: <%= idx * 100 %>ms">
              <div class="w-16 h-16 bg-white rounded-[1.5rem] shadow-sm flex-shrink-0 flex items-center justify-center transition-all duration-500 group-hover:scale-110 group-hover:-rotate-6 <%= color_class %>">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <div class="pt-2">
                <h4 class="text-xl font-black text-slate-900 mb-2 uppercase tracking-tight"><%= t("home.index.strengths.#{key}.title") %></h4>
                <p class="text-slate-500 font-medium leading-relaxed max-w-sm">
                  <%= t("home.index.strengths.#{key}.desc") %>
                </p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Final CTA Section (Deep Overlap) -->
<div id="cta" class="bg-white section-py relative overflow-hidden -mt-20 z-20">
  <div class="narrative-container">
    <div class="relative bg-slate-900 p-12 md:p-24 rounded-[4rem] overflow-hidden shadow-3xl text-center md:text-left flex flex-col md:flex-row items-center justify-between gap-12 group">
      <!-- Decorative Logo Color Blobs -->
      <div class="absolute -bottom-24 -right-24 w-[500px] h-[500px] bg-primary rounded-full blur-[120px] opacity-20 group-hover:opacity-30 transition-opacity duration-1000"></div>
      <div class="absolute -top-24 -left-24 w-[400px] h-[400px] bg-secondary rounded-full blur-[100px] opacity-10 group-hover:opacity-20 transition-opacity duration-1000"></div>

      <div class="relative z-10 max-w-2xl reveal-left">
        <div class="flex justify-center md:justify-start mb-6">
          <span class="eyebrow-unified eyebrow-primary">Final Step</span>
        </div>
        <h2 class="text-4xl md:text-7xl font-black text-white mb-8 leading-[1.1] uppercase tracking-tighter">
          <%= t('home.index.final_cta_title') %>
        </h2>
        <p class="text-white/50 text-xl font-medium max-w-lg">
          <%= t('home.index.final_cta_desc') %>
        </p>
      </div>
      
      <div class="relative z-10 flex-shrink-0 reveal-right">
        <%= link_to contact_path, class: "px-14 py-8 bg-primary hover:bg-primary/90 text-white rounded-3xl font-black text-xl tracking-widest transition-all shadow-2xl flex items-center group scale-100 hover:scale-105 active:scale-95" do %>
          <%= t('home.index.get_free_quote') %>
          <svg class="w-7 h-7 ml-4 group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        <% end %>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes yapai-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @keyframes yapai-marquee-rev {
    from { transform: translateX(-50%); }
    to   { transform: translateX(0); }
  }

  .reveal-up, .reveal-left, .reveal-right, .reveal-product {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 1s cubic-bezier(0.25, 0.46, 0.45, 0.94), 
                transform 1s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .reveal-left  { transform: translateX(-40px); }
  .reveal-right { transform: translateX(40px); }

  .is-visible {
    opacity: 1 !important;
    transform: none !important;
  }

  /* ── Narrative Tokens ── */
  :root {
    --container-max: 1280px;
    --section-spacing: clamp(5rem, 10vw, 10rem);
    --content-spacing: clamp(3rem, 6vw, 6rem);
    --border-radius-lg: 3rem;
    --border-radius-xl: 4rem;
    --transition-narrative: all 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .narrative-container {
    width: 100%;
    max-width: var(--container-max);
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .section-py {
    padding-top: var(--section-spacing);
    padding-bottom: var(--section-spacing);
  }

  .eyebrow-unified {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.25rem 1rem;
    border-radius: 9999px;
    background-color: theme('colors.slate.100');
    color: theme('colors.slate.500');
    font-size: 10px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    margin-bottom: 1.5rem;
  }

  .eyebrow-unified::before {
    content: '';
    width: 1.5rem;
    height: 1px;
    background-color: currentColor;
    opacity: 0.3;
  }

  .eyebrow-primary {
    background-color: rgba(59, 130, 246, 0.05);
    color: theme('colors.primary');
  }

  .h2-unified {
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 900;
    line-height: 1.1;
    color: theme('colors.slate.900');
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .card-narrative {
    border-radius: var(--border-radius-lg);
    border: 1px solid theme('colors.slate.100');
    background: white;
    box-shadow: 0 10px 30px -10px rgba(0,0,0,0.05);
    transition: var(--transition-narrative);
  }

  .card-narrative:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px -10px rgba(0,0,0,0.1);
  }

  .cubic-bezier-narrative {
    transition-timing-function: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .stagger-1 { transition-delay: 0.2s; }
  .stagger-2 { transition-delay: 0.4s; }
  .stagger-3 { transition-delay: 0.6s; }
  .stagger-4 { transition-delay: 0.8s; }

  /* ── Scroll Progress Bar ── */
  .scroll-progress-container {
    position: fixed;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 250px;
    background: rgba(15, 23, 42, 0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(0, 0, 0, 0.03);
    border-radius: 99px;
    z-index: 1000;
    padding: 0;
    box-shadow: 
      0 10px 30px -5px rgba(0, 0, 0, 0.05),
      inset 0 1px 1px rgba(255, 255, 255, 0.8);
    transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.6s;
  }

  .scroll-progress-bar {
    width: 100%;
    height: 0%;
    background: #22c55e; /* Pure green line */
    border-radius: 99px;
    position: relative;
    transition: height 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 
      0 0 15px rgba(34, 197, 94, 0.5),
      0 0 5px rgba(34, 197, 94, 0.8);
  }

  /* Glowing dot at the end */
  .scroll-progress-bar::before {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 50%;
    transform: translateX(-50%);
    width: 9px;
    height: 9px;
    background: #f97316; /* Orange thumb */
    border: 2px solid white;
    border-radius: 50%;
    box-shadow: 
      0 0 20px #f97316,
      0 0 10px #f97316,
      0 4px 10px rgba(0,0,0,0.2);
    z-index: 10;
  }

  .scroll-progress-bar::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(249, 115, 22, 0) 20%,
      rgba(249, 115, 22, 0.9) 50%,
      rgba(249, 115, 22, 0) 80%,
      transparent 100%
    );
    background-size: 100% 200%;
    animation: scroll-glow 1.2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    border-radius: 99px;
    filter: brightness(1.2);
  }

  @keyframes scroll-glow {
    0% { background-position: 0% -200%; opacity: 0; }
    50% { opacity: 1; }
    100% { background-position: 0% 200%; opacity: 0; }
  }

  html {
    scroll-behavior: smooth;
  }
</style>

<!-- Scroll Progress Bar -->
<div class="scroll-progress-container hidden md:block">
  <div id="scroll-progress" class="scroll-progress-bar"></div>
</div>

<script>
  function initHomeAnimations() {
    // 1. Reveal Animations
    const els = document.querySelectorAll(".reveal-up, .reveal-left, .reveal-right, .reveal-product");
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("is-visible");
          obs.unobserve(e.target);
        }
      });
    }, { threshold: 0.1 });

    els.forEach((el) => {
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        el.classList.add("is-visible");
      } else {
        obs.observe(el);
      }
    });
  }

  function initScrollProgress() {
    const progressBar = document.getElementById('scroll-progress');
    const container = document.querySelector('.scroll-progress-container');
    if (!progressBar || !container) return;

    const updateProgress = () => {
      const winScroll = window.pageYOffset || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      
      // Update height
      progressBar.style.height = scrolled + "%";
      
      // Fade in/out logic
      if (scrolled > 1) {
        container.style.opacity = "1";
        container.style.visibility = "visible";
      } else {
        container.style.opacity = "0";
        container.style.visibility = "hidden";
      }
    };

    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress(); // Initial check
  }

  document.addEventListener("DOMContentLoaded", () => {
    initHomeAnimations();
    initScrollProgress();
  });
  document.addEventListener("turbo:load", () => {
    initHomeAnimations();
    initScrollProgress();
  });

  // Re-run on scroll to ensure fresh state if needed
  // window.addEventListener('scroll', () => { ... }, { passive: true });
</script>

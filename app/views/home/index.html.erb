<% content_for :title, "Yapai Battery Factory — Professional Mobile Phone Battery Manufacturer" %>
<% content_for :meta_description, "Yapai manufactures replacement mobile phone batteries for 1,000+ models with OEM/ODM support, flexible MOQ and global delivery." %>
<% content_for :meta_keywords, "mobile phone battery factory, replacement battery manufacturer, OEM battery, ODM battery, Yapai Battery" %>

<div class="yr-home" data-controller="home-reveal">
  <section class="yr-hero" data-controller="slideshow" aria-label="Yapai Battery highlights">
    <div class="yr-hero-media" aria-hidden="true">
      <% [1, 2, 3].each_with_index do |number, index| %>
        <div class="yr-hero-slide <%= index.zero? ? 'opacity-100 scale-100 z-10' : 'opacity-0 scale-110 z-0' %>" data-slideshow-target="slide">
          <%= image_tag "indexbanner#{number}.jpg", alt: "", loading: index.zero? ? "eager" : "lazy" %>
        </div>
      <% end %>
      <div class="yr-hero-shade"></div>
      <div class="yr-hero-grid"></div>
    </div>

    <div class="yr-shell yr-hero-inner">
      <div class="yr-hero-copy-wrap">
        <% [1, 2, 3].each_with_index do |number, index| %>
          <div class="yr-hero-copy <%= index.zero? ? 'opacity-100 translate-y-0 pointer-events-auto' : 'opacity-0 translate-y-12 pointer-events-none' %>" data-slideshow-target="content">
            <p class="yr-eyebrow yr-eyebrow-light">Yapai · Battery Manufacturing</p>
            <h1>
              <span><%= t("home.index.hero_slides.slide#{number}.title1", default: "Professional Battery Factory") %></span>
              <strong><%= t("home.index.hero_slides.slide#{number}.title2", default: "YAPAI BATTERY") %></strong>
            </h1>
            <p class="yr-hero-description"><%= t("home.index.hero_slides.slide#{number}.desc", default: "Professional replacement battery manufacturing for global partners.") %></p>
            <div class="yr-hero-actions">
              <a href="#battery-series" class="yr-button yr-button-primary"><span><%= t("home.index.explore_more", default: "Explore products") %></span><i>↗</i></a>
              <%= link_to factory_path, class: "yr-button yr-button-ghost" do %>
                <span><%= t("home.index.factory_tour", default: "Factory tour") %></span><i>→</i>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="yr-hero-foot">
        <div class="yr-slide-controls" aria-label="Slideshow controls">
          <% 3.times do |index| %>
            <button type="button" data-action="slideshow#goTo" data-index="<%= index %>" data-slideshow-target="indicator" aria-label="Show slide <%= index + 1 %>" aria-pressed="<%= index.zero? %>"><%= format("%02d", index + 1) %></button>
          <% end %>
          <button type="button" class="yr-slide-toggle" data-action="slideshow#toggle" data-slideshow-target="toggle" aria-label="Pause slideshow">Pause</button>
        </div>
        <div class="yr-hero-note"><span></span>OEM / ODM · GLOBAL SUPPLY</div>
      </div>
    </div>
  </section>

  <section class="yr-proof" aria-label="Yapai production highlights">
    <div class="yr-shell yr-proof-grid">
      <div data-home-reveal-target="item"><strong>20</strong><span><%= t("home.index.years_history", default: "Years of experience") %></span></div>
      <div data-home-reveal-target="item"><strong>5,000+</strong><span>Daily capacity</span></div>
      <div data-home-reveal-target="item"><strong>1,000+</strong><span>Compatible models</span></div>
      <div data-home-reveal-target="item"><strong>72H</strong><span>Fast dispatch</span></div>
    </div>
  </section>

  <section class="yr-about yr-section">
    <div class="yr-shell yr-about-grid">
      <div class="yr-about-visual" data-home-reveal-target="item">
        <%= image_tag "factory5.jpg", alt: "Yapai battery production facility", loading: "lazy" %>
        <div class="yr-about-badge"><strong>20</strong><span>Years focused on mobile energy</span></div>
      </div>
      <div class="yr-about-copy" data-home-reveal-target="item">
        <p class="yr-eyebrow">Factory direct · Dongguan</p>
        <h2>Built for reliable<br>global supply.</h2>
        <p><%= t("home.index.who_we_are_desc", default: "Yapai is a professional mobile phone battery manufacturer serving wholesalers, retailers and private-label partners worldwide.") %></p>
        <div class="yr-feature-list">
          <div><span>01</span><strong>Flexible MOQ</strong><p>Support market testing and scalable repeat orders.</p></div>
          <div><span>02</span><strong>OEM / ODM</strong><p>Brand, label and packaging customization.</p></div>
          <div><span>03</span><strong>Quality control</strong><p>Consistent inspection throughout production.</p></div>
        </div>
        <%= link_to factory_path, class: "yr-text-link" do %>Discover our factory <span>↗</span><% end %>
      </div>
    </div>
  </section>

  <section id="battery-series" class="yr-products yr-section">
    <div class="yr-shell">
      <header class="yr-section-heading" data-home-reveal-target="item">
        <div><p class="yr-eyebrow">Battery series</p><h2>Find your fit.</h2></div>
        <p>Replacement batteries engineered for the devices your market already trusts.</p>
      </header>

      <% brands = [
        { name: "iPhone", image: "iphone.webp", models: "Apple series", tone: "#60a5fa" },
        { name: "Samsung", image: "category3.webp", models: "Galaxy series", tone: "#77a9ff" },
        { name: "Huawei", image: "huawei.webp", models: "Mate · P series", tone: "#ff9a62" },
        { name: "Xiaomi", image: "xiaomi.webp", models: "Mi · Redmi", tone: "#ff795e" },
        { name: "OPPO", image: "oppo.webp", models: "Find · Reno", tone: "#79d8a2" },
        { name: "vivo", image: "vivo.webp", models: "X · V series", tone: "#a995ff" },
        { name: "Motorola", image: "category5.webp", models: "Moto series", tone: "#62ccec" },
        { name: "Infinix", image: "category6.webp", models: "Note · Hot", tone: "#eccd58" }
      ] %>
      <div class="yr-product-grid">
        <% brands.each_with_index do |brand, index| %>
          <% category = @featured_categories.find { |item| item.name.to_s.downcase.include?(brand[:name].downcase) } %>
          <%= link_to(category ? category_path(category) : products_path, class: "yr-product-card", style: "--yr-accent: #{brand[:tone]}", data: { home_reveal_target: "item" }) do %>
            <div class="yr-product-image"><%= image_tag brand[:image], alt: "#{brand[:name]} replacement battery", loading: "lazy" %><span><%= format("%02d", index + 1) %></span></div>
            <div class="yr-product-meta"><div><small><%= brand[:models] %></small><h3><%= brand[:name] %></h3></div><i>↗</i></div>
          <% end %>
        <% end %>
      </div>
      <div class="yr-products-foot" data-home-reveal-target="item"><%= link_to products_path, class: "yr-button yr-button-dark" do %><span>View all products</span><i>→</i><% end %></div>
    </div>
  </section>

  <section class="yr-capability yr-section">
    <div class="yr-shell">
      <header class="yr-section-heading yr-section-heading-light" data-home-reveal-target="item">
        <div><p class="yr-eyebrow yr-eyebrow-light">Manufacturing capability</p><h2>Scale without<br>the friction.</h2></div>
        <p>From product selection to shipment, one experienced team keeps every detail moving.</p>
      </header>
      <div class="yr-capability-grid">
        <% [["01", "Select", "Choose from 1,000+ compatible models."], ["02", "Customize", "Apply your logo, label and packaging."], ["03", "Produce", "Flexible quantities with controlled output."], ["04", "Deliver", "Fast preparation for worldwide shipping."]].each do |number, title, description| %>
          <article data-home-reveal-target="item"><span><%= number %></span><h3><%= title %></h3><p><%= description %></p></article>
        <% end %>
      </div>
    </div>
  </section>

  <section class="yr-factory yr-section">
    <div class="yr-shell yr-factory-grid">
      <div class="yr-factory-copy" data-home-reveal-target="item">
        <p class="yr-eyebrow">Inside Yapai</p>
        <h2>Manufacturing you can see.</h2>
        <p>Our Dongguan facility brings production, inspection and packing together under one roof.</p>
        <dl><div><dt>10,000㎡</dt><dd>Factory space</dd></div><div><dt>50+</dt><dd>Production units</dd></div><div><dt>100%</dt><dd>Final inspection</dd></div></dl>
        <%= link_to factory_path, class: "yr-text-link" do %>Explore production <span>↗</span><% end %>
      </div>
      <div class="yr-factory-gallery" data-home-reveal-target="item">
        <%= image_tag "factory1.jpg", alt: "Battery production line", loading: "lazy" %>
        <%= image_tag "worker2.jpg", alt: "Yapai production team", loading: "lazy" %>
        <%= image_tag "factory3.jpg", alt: "Battery quality inspection", loading: "lazy" %>
      </div>
    </div>
  </section>

  <section class="yr-cta yr-section">
    <div class="yr-shell">
      <div class="yr-cta-panel" data-home-reveal-target="item">
        <div class="yr-cta-copy">
          <p class="yr-eyebrow yr-eyebrow-light">Human support · Factory response</p>
          <h2>Connect with<br>our battery team.</h2>
          <p>Share your target models, quantity and branding requirements. A dedicated specialist will turn them into a clear factory proposal.</p>
          <div class="yr-cta-signals" aria-label="Service highlights">
            <span><i></i>Online now</span>
            <span><strong>&lt; 12H</strong> First response</span>
            <span><strong>1 : 1</strong> Project support</span>
          </div>
          <%= link_to contact_path, class: "yr-button yr-button-light" do %><span><%= t("home.index.get_free_quote", default: "Get a quote") %></span><i>↗</i><% end %>
        </div>

        <div class="yr-support-console">
          <div class="yr-console-grid" aria-hidden="true"></div>
          <div class="yr-console-ring" aria-hidden="true"><span></span></div>
          <figure class="yr-support-portrait">
            <%= image_tag "/support-agent.jpg", alt: "Yapai customer service specialist wearing a headset", loading: "lazy" %>
          </figure>
          <div class="yr-agent-card">
            <div class="yr-agent-status"><span></span>AVAILABLE</div>
            <strong>Project Specialist</strong>
            <small>OEM / ODM SUPPORT</small>
          </div>
          <div class="yr-console-data yr-console-data-a"><span>CHANNEL</span><strong>GLOBAL / 24</strong></div>
          <div class="yr-console-data yr-console-data-b"><span>RESPONSE</span><strong>ACTIVE</strong></div>
        </div>
      </div>
    </div>
  </section>
</div>

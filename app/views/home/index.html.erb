<% content_for :title, "Yapai Battery Factory — Energy Engineered to Move" %>
<% content_for :meta_description, "Yapai is a professional mobile phone battery manufacturer in Dongguan, China, supplying OEM/ODM replacement batteries for 1,000+ models worldwide." %>
<% content_for :meta_keywords, "mobile phone battery factory, replacement battery manufacturer, OEM battery, ODM battery, Yapai Battery" %>
<div class="yp-experience"
     data-controller="energy-experience"
     data-energy-experience-reduced-motion-value="false">
  <div class="yp-progress" aria-hidden="true">
    <span data-energy-experience-target="progress"></span>
  </div>

  <div class="yp-dark-world" data-energy-experience-target="darkWorld">
    <div class="yp-stage" aria-hidden="true">
      <canvas class="yp-webgl" data-energy-experience-target="canvas"></canvas>
      <div class="yp-stage-glow"></div>
      <div class="yp-stage-grid"></div>
      <div class="yp-energy-reticle">
        <span></span><span></span><span></span>
      </div>
      <div class="yp-battery-signature">
        <span>YAPAI</span>
        <small>INTELLIGENT ENERGY CORE</small>
      </div>
      <div class="yp-webgl-fallback" data-energy-experience-target="fallback">
        <span class="yp-fallback-cap"></span>
        <span class="yp-fallback-charge"></span>
      </div>

      <div class="yp-stage-hud">
        <div class="yp-hud-state">
          <span class="yp-hud-pulse"></span>
          <span data-energy-experience-target="stateLabel"><%= t("home.index.experience.hud_state") %></span>
        </div>
        <div class="yp-hud-charge">
          <span><%= t("home.index.experience.energy_core") %></span>
          <strong data-energy-experience-target="chargeLabel">36%</strong>
        </div>
      </div>
    </div>

    <nav class="yp-scene-nav" aria-label="Homepage chapters">
      <% %w[hero engineering capacity compatibility products factory-story start-project].each_with_index do |scene, index| %>
        <a href="#<%= scene %>"
           data-energy-experience-target="sceneDot"
           data-scene-name="<%= scene %>"
           class="<%= "is-active" if index.zero? %>"
           aria-label="Go to chapter <%= index + 1 %>">
          <span><%= format("%02d", index + 1) %></span>
        </a>
      <% end %>
    </nav>

    <div class="yp-dark-content">
      <section id="hero" class="yp-hero yp-scene" data-scene="hero" data-state-label="<%= t("home.index.experience.states.hero") %>" data-energy-experience-target="scene">
        <div class="yp-shell yp-hero-grid">
          <div class="yp-hero-copy">
            <div class="yp-kicker" data-hero-reveal>
              <span></span>
              <%= t("home.index.experience.hero.kicker") %>
            </div>

            <h1 class="yp-display" data-hero-reveal>
              <span><%= t("home.index.experience.hero.title_line_1") %></span>
              <em><%= t("home.index.experience.hero.title_line_2") %></em>
            </h1>

            <p class="yp-hero-lede" data-hero-reveal>
              <%= t("home.index.experience.hero.description") %>
            </p>

            <div class="yp-actions" data-hero-reveal>
              <a href="#products" class="yp-button yp-button-primary" data-energy-experience-target="magnetic">
                <span><%= t("home.index.experience.hero.primary_cta") %></span>
                <i aria-hidden="true">↗</i>
              </a>
              <%= link_to contact_path, class: "yp-button yp-button-ghost", data: { energy_experience_target: "magnetic" } do %>
                <span><%= t("home.index.experience.hero.secondary_cta") %></span>
                <i aria-hidden="true">→</i>
              <% end %>
            </div>

            <dl class="yp-hero-stats" data-hero-reveal>
              <div>
                <dt><%= t("home.index.experience.hero.stats.output") %></dt>
                <dd><span data-energy-experience-target="counter" data-value="5000" data-suffix="+">5,000+</span></dd>
              </div>
              <div>
                <dt><%= t("home.index.experience.hero.stats.models") %></dt>
                <dd><span data-energy-experience-target="counter" data-value="1000" data-suffix="+">1,000+</span></dd>
              </div>
              <div>
                <dt><%= t("home.index.experience.hero.stats.dispatch") %></dt>
                <dd><span data-energy-experience-target="counter" data-value="72" data-suffix="H">72H</span></dd>
              </div>
            </dl>
          </div>

          <div class="yp-object-space" aria-hidden="true">
            <div class="yp-orbit-label yp-orbit-label-a"><span>01</span> OEM / ODM</div>
            <div class="yp-orbit-label yp-orbit-label-b"><span>02</span> QC VERIFIED</div>
          </div>
        </div>

        <a href="#engineering" class="yp-scroll-cue" aria-label="Scroll to engineering chapter">
          <span><%= t("home.index.experience.scroll") %></span>
          <i></i>
        </a>
      </section>

      <section id="engineering" class="yp-chapter yp-scene" data-scene="engineering" data-state-label="<%= t("home.index.experience.states.engineering") %>" data-energy-experience-target="scene">
        <div class="yp-shell yp-chapter-grid">
          <article class="yp-story-card" data-chapter-reveal>
            <div class="yp-chapter-index">01 <span>/ 03</span></div>
            <p class="yp-kicker yp-kicker-compact"><%= t("home.index.experience.engineering.kicker") %></p>
            <h2><%= t("home.index.experience.engineering.title") %></h2>
            <p><%= t("home.index.experience.engineering.description") %></p>
            <div class="yp-spec-row">
              <div><strong>20</strong><span><%= t("home.index.experience.engineering.years") %></span></div>
              <div><strong>4×</strong><span><%= t("home.index.experience.engineering.qc") %></span></div>
            </div>
          </article>
          <div></div>
        </div>
      </section>

      <section id="capacity" class="yp-chapter yp-scene" data-scene="capacity" data-state-label="<%= t("home.index.experience.states.capacity") %>" data-energy-experience-target="scene">
        <div class="yp-shell yp-chapter-grid yp-chapter-grid-reverse">
          <div></div>
          <article class="yp-story-card" data-chapter-reveal>
            <div class="yp-chapter-index">02 <span>/ 03</span></div>
            <p class="yp-kicker yp-kicker-compact"><%= t("home.index.experience.capacity.kicker") %></p>
            <h2><%= t("home.index.experience.capacity.title") %></h2>
            <p><%= t("home.index.experience.capacity.description") %></p>
            <div class="yp-meter-list">
              <div><span><%= t("home.index.experience.capacity.flexibility") %></span><i style="--meter: 92%"></i></div>
              <div><span><%= t("home.index.experience.capacity.speed") %></span><i style="--meter: 86%"></i></div>
              <div><span><%= t("home.index.experience.capacity.consistency") %></span><i style="--meter: 96%"></i></div>
            </div>
          </article>
        </div>
      </section>

      <section id="compatibility" class="yp-chapter yp-scene" data-scene="compatibility" data-state-label="<%= t("home.index.experience.states.compatibility") %>" data-energy-experience-target="scene">
        <div class="yp-shell yp-chapter-grid">
          <article class="yp-story-card" data-chapter-reveal>
            <div class="yp-chapter-index">03 <span>/ 03</span></div>
            <p class="yp-kicker yp-kicker-compact"><%= t("home.index.experience.compatibility.kicker") %></p>
            <h2><%= t("home.index.experience.compatibility.title") %></h2>
            <p><%= t("home.index.experience.compatibility.description") %></p>
            <div class="yp-brand-cloud" aria-label="Supported device brands">
              <% %w[iPhone Samsung Huawei Xiaomi OPPO vivo Motorola Infinix].each do |brand| %>
                <span><%= brand %></span>
              <% end %>
            </div>
          </article>
          <div></div>
        </div>
      </section>
    </div>

  <section id="products" class="yp-products yp-light-section yp-scene" data-scene="products" data-state-label="<%= t("home.index.experience.states.products") %>" data-energy-experience-target="scene">
    <div class="yp-shell">
      <header class="yp-section-heading" data-section-reveal>
        <div>
          <p class="yp-kicker yp-kicker-dark"><%= t("home.index.experience.products.kicker") %></p>
          <h2><%= t("home.index.experience.products.title") %></h2>
        </div>
        <div class="yp-section-side">
          <p><%= t("home.index.experience.products.description") %></p>
          <%= link_to products_path, class: "yp-text-link" do %>
            <%= t("home.index.experience.products.view_all") %> <span aria-hidden="true">↗</span>
          <% end %>
        </div>
      </header>

      <div class="yp-product-grid">
        <% battery_brands = [
             { name: "iPhone", image: "iphone.webp", tag: "Apple series", tone: "#b8ff3d" },
             { name: "Samsung", image: "category3.webp", tag: "Galaxy series", tone: "#66b8ff" },
             { name: "Huawei", image: "huawei.webp", tag: "Mate · P series", tone: "#ff9c2a" },
             { name: "Xiaomi", image: "xiaomi.webp", tag: "Mi · Redmi series", tone: "#ff6c4a" },
             { name: "OPPO", image: "oppo.webp", tag: "Find · Reno series", tone: "#7ee8a8" },
             { name: "vivo", image: "vivo.webp", tag: "X · V series", tone: "#a78bfa" },
             { name: "Motorola", image: "category5.webp", tag: "Moto series", tone: "#66e0ff" },
             { name: "Infinix", image: "category6.webp", tag: "Note · Hot series", tone: "#f7d154" }
           ] %>
        <% battery_brands.each_with_index do |brand, index| %>
          <% category = @featured_categories.find { |item| item.name.to_s.downcase.include?(brand[:name].downcase) } %>
          <% destination = category ? category_path(category) : products_path %>
          <%= link_to destination, class: "yp-product-card yp-brand-card", style: "--card-accent: #{brand[:tone]}", data: { section_reveal: true, tilt_card: true, brand: brand[:name].downcase } do %>
            <div class="yp-product-image">
              <%= image_tag brand[:image], alt: "#{brand[:name]} replacement battery", loading: "lazy" %>
              <span class="yp-product-number"><%= format("%02d", index + 1) %></span>
              <span class="yp-brand-chip"><%= brand[:name] %></span>
            </div>
            <div class="yp-product-meta">
              <div>
                <span><%= brand[:tag] %></span>
                <h3><%= brand[:name] %> battery</h3>
              </div>
              <i aria-hidden="true">↗</i>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>

  <section id="factory-story" class="yp-factory yp-light-section yp-scene" data-scene="factory-story" data-state-label="<%= t("home.index.experience.states.factory") %>" data-energy-experience-target="scene">
    <div class="yp-shell yp-factory-grid">
      <div class="yp-factory-visual" data-section-reveal>
        <%= image_tag "factory5.jpg", alt: "Yapai battery manufacturing facility", loading: "lazy" %>
        <div class="yp-factory-caption">
          <span><%= t("home.index.experience.factory.location") %></span>
          <strong><%= t("home.index.experience.factory.caption") %></strong>
        </div>
      </div>

      <div class="yp-factory-copy" data-section-reveal>
        <p class="yp-kicker yp-kicker-dark"><%= t("home.index.experience.factory.kicker") %></p>
        <h2><%= t("home.index.experience.factory.title") %></h2>
        <p><%= t("home.index.experience.factory.description") %></p>
        <dl>
          <div><dt>10,000㎡</dt><dd><%= t("home.index.experience.factory.scale") %></dd></div>
          <div><dt>50+</dt><dd><%= t("home.index.experience.factory.lines") %></dd></div>
          <div><dt>100%</dt><dd><%= t("home.index.experience.factory.testing") %></dd></div>
        </dl>
        <%= link_to factory_path, class: "yp-text-link yp-text-link-dark" do %>
          <%= t("home.index.experience.factory.cta") %> <span aria-hidden="true">↗</span>
        <% end %>
      </div>
    </div>
  </section>

  <section id="start-project" class="yp-final-cta yp-light-section yp-scene" data-scene="start-project" data-state-label="<%= t("home.index.experience.states.cta") %>" data-energy-experience-target="scene">
    <div class="yp-shell">
      <div class="yp-cta-panel" data-section-reveal>
        <div class="yp-cta-orbit" aria-hidden="true"><span></span><i></i></div>
        <p class="yp-kicker"><%= t("home.index.experience.cta.kicker") %></p>
        <h2><%= t("home.index.experience.cta.title") %></h2>
        <p><%= t("home.index.experience.cta.description") %></p>
        <%= link_to contact_path, class: "yp-button yp-button-light", data: { energy_experience_target: "magnetic" } do %>
          <span><%= t("home.index.experience.cta.button") %></span>
          <i aria-hidden="true">↗</i>
        <% end %>
      </div>
    </div>
  </section>
  </div>
</div>

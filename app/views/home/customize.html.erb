<% content_for :title, "Customized Service - Professional Mobile Phone Battery OEM/ODM - Yapai" %>
<% content_for :meta_description, t('home.customize.hero.description') %>

<div class="bg-white">
  <!-- 1. Hero Section -->
  <section class="relative py-24 md:py-40 flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <%= image_tag "indexbanner2.webp", class: "w-full h-full object-cover object-center", alt: "Customization Service" %>
      <div class="absolute inset-0 bg-black/60"></div>
    </div>
    
    <div class="container mx-auto px-6 relative z-10">
      <div class="max-w-3xl">
        <span class="inline-block px-4 py-1.5 bg-primary text-white text-xs font-bold tracking-widest uppercase rounded-full mb-6">
          <%= t('home.customize.hero.tag') %>
        </span>
        <h1 class="text-4xl md:text-6xl font-black text-white leading-tight mb-6">
          <%= t('home.customize.hero.title') %><br/>
          <span class="text-primary"><%= t('home.customize.hero.subtitle') %></span>
        </h1>
        <p class="text-lg text-white/80 mb-10 leading-relaxed max-w-2xl">
          <%= t('home.customize.hero.description') %>
        </p>

      </div>
    </div>
  </section>




  <!-- 3. Customization Process -->
  <section class="relative py-24 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <%= image_tag "factory4.jpg", class: "w-full h-full object-cover", alt: "Production Process" %>
      <div class="absolute inset-0 bg-slate-900/80"></div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-black text-white mb-4"><%= t('home.customize.process.title') %></h2>
        <p class="text-white/60 max-w-2xl mx-auto"><%= t('home.customize.process.subtitle') %></p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-6">
        <% (1..6).each do |i| %>
          <div class="relative group">
            <div class="bg-white/10 backdrop-blur-md p-8 rounded-3xl border border-white/10 hover:bg-primary/20 transition-all duration-500 h-full text-center">
              <div class="w-12 h-12 bg-primary rounded-full flex items-center justify-center text-white font-black text-xl mx-auto mb-6 shadow-lg shadow-primary/30">
                <%= i %>
              </div>
              <h3 class="text-white font-bold text-lg mb-2"><%= t("home.customize.process.step#{i}") %></h3>
              <p class="text-white/50 text-sm"><%= t("home.customize.process.step#{i}_desc") %></p>
            </div>
            <% if i < 6 %>
              <div class="hidden lg:block absolute top-1/2 -right-3 transform -translate-y-1/2 z-20">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"></path>
                </svg>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </section>




  <!-- 4. Design & R&D Capability -->
  <section class="py-24 bg-dark text-white">
    <div class="container mx-auto px-6">
      <div class="flex flex-col lg:flex-row items-center gap-16">
        <div class="w-full lg:w-1/2">
          <div class="relative">
            <%= image_tag "worker1.jpg", class: "rounded-3xl shadow-2xl relative z-10", alt: "Design & R&D" %>
            <div class="absolute -top-6 -left-6 w-24 h-24 bg-primary rounded-2xl -z-10 animate-pulse"></div>
            <div class="absolute -bottom-6 -right-6 w-32 h-32 border-4 border-white/20 rounded-2xl -z-10"></div>
          </div>
        </div>
        <div class="w-full lg:w-1/2">
          <h2 class="text-3xl md:text-5xl font-black mb-6"><%= t('home.customize.design_rd.title') %></h2>
          <p class="text-white/60 text-lg mb-10 leading-relaxed"><%= t('home.customize.design_rd.subtitle') %></p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <% ['product_design', 'sample_dev', 'tech_support', 'process_opt'].each do |key| %>
              <div class="flex items-center gap-4 p-4 bg-white/5 rounded-2xl border border-white/10 hover:bg-white/10 transition-colors">
                <div class="w-10 h-10 bg-primary rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <span class="font-bold text-sm tracking-wide"><%= t("home.customize.design_rd.items.#{key}") %></span>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>










  <!-- 8. Conversion Section -->
  <section class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 z-0">
      <%= image_tag "indexbanner3.webp", class: "w-full h-full object-cover", alt: "Contact Yapai" %>
      <div class="absolute inset-0 bg-primary/90"></div>
    </div>
    <div class="container mx-auto px-6 text-center relative z-10">
      <h2 class="text-3xl md:text-5xl font-black text-white mb-8"><%= t('home.customize.conversion.title') %></h2>
      <p class="text-white/80 text-lg mb-12 max-w-2xl mx-auto"><%= t('home.customize.conversion.subtitle') %></p>
      <%= link_to contact_path, class: "inline-flex items-center px-10 py-5 bg-white text-primary font-black rounded-full hover:bg-slate-50 transition-all transform hover:scale-105 shadow-2xl" do %>
        <%= t('home.customize.conversion.cta') %>
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      <% end %>
    </div>
  </section>
</div>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>

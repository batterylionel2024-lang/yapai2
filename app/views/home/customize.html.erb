<% content_for :title, "Customized Service - Professional Mobile Phone Battery OEM/ODM - Yapai" %>
<% content_for :meta_description, t('home.customize.hero.description') %>

<div class="bg-white">
  <!-- 1. Hero Section -->
  <section class="relative h-[70vh] min-h-[500px] flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <%= image_tag "indexbanner2.webp", class: "w-full h-full object-cover", alt: "Customization Service" %>
      <div class="absolute inset-0 bg-black/60"></div>
    </div>
    
    <div class="container mx-auto px-6 relative z-10">
      <div class="max-w-3xl">
        <span class="inline-block px-4 py-1.5 bg-primary text-white text-xs font-bold tracking-widest uppercase rounded-full mb-6">
          <%= t('home.customize.hero.tag') %>
        </span>
        <h1 class="text-4xl md:text-6xl font-black text-white leading-tight mb-6">
          <%= t('home.customize.hero.title') %><br/>
          <span class="text-primary"><%= t('home.customize.hero.subtitle') %></span>
        </h1>
        <p class="text-lg text-white/80 mb-10 leading-relaxed max-w-2xl">
          <%= t('home.customize.hero.description') %>
        </p>
        <div class="flex flex-wrap gap-4">
          <%= link_to contact_path, class: "px-8 py-4 bg-primary text-white font-black rounded-full hover:bg-primary/90 transition-all transform hover:-translate-y-1 shadow-lg shadow-primary/30" do %>
            <%= t('home.customize.hero.cta') %>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Customization Capabilities -->
  <section class="py-24 bg-slate-50">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-black text-slate-900 mb-4"><%= t('home.customize.capabilities.title') %></h2>
        <p class="text-slate-500 max-w-2xl mx-auto"><%= t('home.customize.capabilities.subtitle') %></p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <% [
          { key: 'appearance', icon: 'M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z' },
          { key: 'material', icon: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.618.309a6 6 0 01-3.86.517l-2.387-.477a2 2 0 00-1.022.547l-1.16 1.16a2 2 0 004.447 7.933L8 20l.53-.176a2 2 0 001.13-1.13l.176-.53.176.53a2 2 0 001.13 1.13l.53.176.53-.176a2 2 0 001.13-1.13l.176-.53.176.53a2 2 0 001.13 1.13l.53.176.53-.176a2 2 0 001.13-1.13l.176-.53.53.176a2 2 0 004.447-7.933l-1.16-1.16z' },
          { key: 'dimensions', icon: 'M3 8V4m0 0h4M3 4l4 4m8 0V4m0 0h-4m4 0l-4 4m-8 4v4m0 0h4m-4 0l4-4m8 4v-4m0 0h-4m4 0l-4 4' },
          { key: 'packaging', icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-14v14m0-14L4 7m8 4v10M4 7v10l8 4' }
        ].each do |item| %>
          <div class="bg-white p-8 rounded-3xl border border-slate-100 shadow-sm hover:shadow-xl transition-all duration-300 group">
            <div class="w-16 h-16 bg-primary/10 rounded-2xl flex items-center justify-center text-primary mb-6 group-hover:scale-110 transition-transform">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= item[:icon] %>"></path></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3"><%= t("home.customize.capabilities.items.#{item[:key]}.title") %></h3>
            <p class="text-slate-500 text-sm leading-relaxed"><%= t("home.customize.capabilities.items.#{item[:key]}.desc") %></p>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- 3. Customization Process -->
  <section class="relative py-24 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <%= image_tag "factory4.jpg", class: "w-full h-full object-cover", alt: "Production Process" %>
      <div class="absolute inset-0 bg-slate-900/80"></div>
    </div>
    
    <div class="container mx-auto px-6 relative z-10">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-black text-white mb-4"><%= t('home.customize.process.title') %></h2>
        <p class="text-white/60 max-w-2xl mx-auto"><%= t('home.customize.process.subtitle') %></p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-6">
        <% (1..6).each do |i| %>
          <div class="relative group">
            <div class="bg-white/10 backdrop-blur-md p-8 rounded-3xl border border-white/10 hover:bg-primary/20 transition-all duration-500 h-full text-center">
              <div class="w-12 h-12 bg-primary rounded-full flex items-center justify-center text-white font-black text-xl mx-auto mb-6 shadow-lg shadow-primary/30">
                <%= i %>
              </div>
              <h3 class="text-white font-bold text-lg mb-2"><%= t("home.customize.process.step#{i}") %></h3>
              <p class="text-white/50 text-sm"><%= t("home.customize.process.step#{i}_desc") %></p>
            </div>
            <% if i < 6 %>
              <div class="hidden lg:block absolute top-1/2 -right-3 transform -translate-y-1/2 z-20">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"></path>
                </svg>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </section>


  <!-- 4. Design & R&D Capability -->
  <section class="py-24 bg-dark text-white">
    <div class="container mx-auto px-6">
      <div class="flex flex-col lg:flex-row items-center gap-16">
        <div class="w-full lg:w-1/2">
          <div class="relative">
            <%= image_tag "worker1.jpg", class: "rounded-3xl shadow-2xl relative z-10", alt: "Design & R&D" %>
            <div class="absolute -top-6 -left-6 w-24 h-24 bg-primary rounded-2xl -z-10 animate-pulse"></div>
            <div class="absolute -bottom-6 -right-6 w-32 h-32 border-4 border-white/20 rounded-2xl -z-10"></div>
          </div>
        </div>
        <div class="w-full lg:w-1/2">
          <h2 class="text-3xl md:text-5xl font-black mb-6"><%= t('home.customize.design_rd.title') %></h2>
          <p class="text-white/60 text-lg mb-10 leading-relaxed"><%= t('home.customize.design_rd.subtitle') %></p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <% ['product_design', 'sample_dev', 'tech_support', 'process_opt'].each do |key| %>
              <div class="flex items-center gap-4 p-4 bg-white/5 rounded-2xl border border-white/10 hover:bg-white/10 transition-colors">
                <div class="w-10 h-10 bg-primary rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <span class="font-bold text-sm tracking-wide"><%= t("home.customize.design_rd.items.#{key}") %></span>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Production Capacity -->
  <section class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 z-0">
      <%= image_tag "factory5.jpg", class: "w-full h-full object-cover", alt: "Production Capacity" %>
      <div class="absolute inset-0 bg-white/90"></div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-black text-slate-900 mb-4"><%= t('home.customize.production.title') %></h2>
        <p class="text-slate-500 max-w-2xl mx-auto"><%= t('home.customize.production.subtitle') %></p>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-8 mb-16">
        <% [
          { label: 'scale', value: '10,000㎡', img: 'factory1.jpg' },
          { label: 'equipment', value: '50+ Units', img: 'factory2.jpg' },
          { label: 'team', value: '200+ People', img: 'worker2.jpg' },
          { label: 'qc', value: '100% Passed', img: 'factory3.jpg' }
        ].each do |stat| %>
          <div class="relative group h-64 overflow-hidden rounded-3xl shadow-lg">
            <%= image_tag stat[:img], class: "w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" %>
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex flex-col justify-end p-6">
              <span class="text-primary text-2xl font-black mb-1"><%= stat[:value] %></span>
              <span class="text-white/80 text-xs font-bold uppercase tracking-widest"><%= t("home.customize.production.items.#{stat[:label]}") %></span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>



  <!-- 8. Conversion Section -->
  <section class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 z-0">
      <%= image_tag "indexbanner3.webp", class: "w-full h-full object-cover", alt: "Contact Yapai" %>
      <div class="absolute inset-0 bg-primary/90"></div>
    </div>
    <div class="container mx-auto px-6 text-center relative z-10">
      <h2 class="text-3xl md:text-5xl font-black text-white mb-8"><%= t('home.customize.conversion.title') %></h2>
      <p class="text-white/80 text-lg mb-12 max-w-2xl mx-auto"><%= t('home.customize.conversion.subtitle') %></p>
      <%= link_to contact_path, class: "inline-flex items-center px-10 py-5 bg-white text-primary font-black rounded-full hover:bg-slate-50 transition-all transform hover:scale-105 shadow-2xl" do %>
        <%= t('home.customize.conversion.cta') %>
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      <% end %>
    </div>
  </section>
</div>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>

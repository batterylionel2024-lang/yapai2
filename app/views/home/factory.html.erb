<style>
  @keyframes marquee-strip {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @keyframes marquee-strip-reverse {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }

  .reveal-left, .reveal-right, .reveal-up, .reveal-stat,
  .reveal-hero, .reveal-process, .reveal-card, .reveal-from-right-large {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .reveal-hero { transition-delay: 0.1s; }
  .reveal-left { transform: translateX(-32px); }
  .reveal-right { transform: translateX(32px); }
  .reveal-from-right-large { 
    transform: translateX(100vw); 
    transition: opacity 1.5s cubic-bezier(0.22, 1, 0.36, 1), transform 1.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .reveal-card:nth-child(1) { transition-delay: 0.1s; }
  .reveal-card:nth-child(2) { transition-delay: 0.2s; }
  .reveal-card:nth-child(3) { transition-delay: 0.3s; }

  .revealed {
    opacity: 1 !important;
    transform: none !important;
  }

  @keyframes gradient-x {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  .animate-gradient-x {
    background-size: 200% 200%;
    animation: gradient-x 5s ease infinite;
  }
</style>

<script>
  function initFactoryAnimations() {
    // Scroll reveal
    const revealEls = document.querySelectorAll(
      ".reveal-left, .reveal-right, .reveal-up, .reveal-stat, .reveal-hero, .reveal-process, .reveal-card, .reveal-from-right-large"
    );
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("revealed");
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.05 });

    revealEls.forEach((el) => {
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        el.classList.add("revealed");
      } else {
        observer.observe(el);
      }
    });

    // Animated counters
    function animateCounter(el) {
      if (el.dataset.animated) return;
      el.dataset.animated = "1";
      const target = parseInt(el.dataset.target, 10);
      const step = target / (1800 / 16);
      let current = 0;
      const timer = setInterval(() => {
        current += step;
        if (current >= target) { current = target; clearInterval(timer); }
        el.textContent = target >= 1000000
          ? (current / 1000000).toFixed(1) + "M"
          : Math.floor(current).toLocaleString();
      }, 16);
    }

    const counterObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.querySelectorAll(".counter").forEach(animateCounter);
          counterObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3 });
    document.querySelectorAll(".reveal-stat").forEach(el => counterObserver.observe(el));
  }

  document.addEventListener("DOMContentLoaded", initFactoryAnimations);
  document.addEventListener("turbo:load", initFactoryAnimations);
</script>

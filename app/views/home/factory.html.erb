<% content_for :title, "Our Factory - Yapai Battery Manufacturing in Dongguan, China" %>
<% content_for :meta_description, "Visit the Yapai Battery Factory in Dongguan, China. Daily production capacity exceeds 5,000 battery packs, supporting OEM/ODM orders with free brand logo customization." %>
<% content_for :meta_keywords, "battery factory China, mobile phone battery manufacturer, battery manufacturing facility, OEM battery factory, Yapai factory" %>

<div class="bg-slate-50 min-h-screen overflow-x-hidden">

  <!-- Hero Section -->
  <div class="relative bg-slate-900 py-36 sm:py-44 overflow-hidden">
    <div class="absolute inset-0">
      <%= image_tag "factory1.jpg", class: "w-full h-full object-cover opacity-30" %>
      <div class="absolute inset-0 bg-gradient-to-br from-slate-900/90 via-slate-900/40 to-primary/20"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <div class="reveal-hero flex flex-col items-center">
        <p class="text-white/90 font-bold tracking-[0.2em] uppercase text-xs mb-4 px-4 py-1 bg-white/10 backdrop-blur-md rounded-full border border-white/20">
          Professional Battery Manufacturer
        </p>
        <h1 class="text-5xl font-black tracking-tight text-white sm:text-7xl mb-6 leading-tight drop-shadow-2xl">
          About <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-emerald-400">Yapai</span>
        </h1>
        <p class="text-xl leading-8 text-slate-300 max-w-2xl font-medium drop-shadow-sm">
          Yapai Battery Factory is a professional mobile phone battery manufacturer headquartered in Guangdong, China, with its production plant located in Dongguan. The company focuses on the R&D, production, and global export of replacement batteries for smartphones.
        </p>
      </div>
    </div>
    <!-- Decorative elements -->
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-primary/20 rounded-full blur-[100px] animate-pulse"></div>
    <div class="absolute -top-24 -left-24 w-72 h-72 bg-emerald-500/10 rounded-full blur-[80px]"></div>
  </div>

  <!-- ===== MARQUEE PHOTO STRIP ===== -->
  <div class="bg-slate-900 py-8 overflow-hidden relative z-10 -mt-10 rounded-t-[3rem] shadow-[0_-20px_50px_rgba(0,0,0,0.1)]">
    <div class="flex gap-6" style="animation: marquee-strip 28s linear infinite; width: max-content;">
      <% if @site_config.factory_images.attached? %>
        <% 2.times do %>
          <% @site_config.factory_images.each do |image| %>
            <%= image_tag image, class: "h-56 w-80 object-cover rounded-2xl flex-shrink-0 shadow-lg border border-white/5" %>
          <% end %>
        <% end %>
      <% else %>
        <% 2.times do %>
          <%= image_tag "factory1.jpg", class: "h-56 w-80 object-cover rounded-2xl flex-shrink-0 shadow-lg border border-white/5" %>
          <%= image_tag "factory2.jpg", class: "h-56 w-80 object-cover rounded-2xl flex-shrink-0 shadow-lg border border-white/5" %>
          <%= image_tag "factory3.jpg", class: "h-56 w-80 object-cover rounded-2xl flex-shrink-0 shadow-lg border border-white/5" %>
          <%= image_tag "factory4.jpg", class: "h-56 w-80 object-cover rounded-2xl flex-shrink-0 shadow-lg border border-white/5" %>
          <%= image_tag "factory5.jpg", class: "h-56 w-80 object-cover rounded-2xl flex-shrink-0 shadow-lg border border-white/5" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- ===== ANIMATED STATS ===== -->
  <div class="bg-slate-900 py-20 border-t border-white/5">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div class="reveal-stat">
          <div class="text-5xl font-black text-white mb-2"><span class="counter" data-target="20">0</span>+</div>
          <div class="text-white/70 text-sm font-semibold uppercase tracking-widest">Years Experience</div>
        </div>
        <div class="reveal-stat">
          <div class="text-5xl font-black text-white mb-2"><span class="counter" data-target="200">0</span>+</div>
          <div class="text-white/70 text-sm font-semibold uppercase tracking-widest">Skilled Workers</div>
        </div>
        <div class="reveal-stat">
          <div class="text-5xl font-black text-white mb-2"><span class="counter" data-target="30">0</span>+</div>
          <div class="text-white/70 text-sm font-semibold uppercase tracking-widest">Countries Served</div>
        </div>
        <div class="reveal-stat">
          <div class="text-5xl font-black text-white mb-2"><span class="counter" data-target="5000000">0</span>+</div>
          <div class="text-white/70 text-sm font-semibold uppercase tracking-widest">Battery Packs Per Year</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== MANUFACTURING EXCELLENCE ===== -->
  <div class="relative bg-slate-900 py-24 sm:py-32 overflow-hidden -mt-1">
    <div class="absolute inset-0 opacity-20">
      <%= image_tag "factory4.jpg", class: "w-full h-full object-cover" %>
    </div>
    <div class="absolute top-0 left-0 w-full h-24 bg-gradient-to-b from-slate-900 to-transparent"></div>
    <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="reveal-left">
          <p class="text-primary font-semibold tracking-widest uppercase text-sm mb-3">Est. 2003</p>
          <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl mb-8">Professional Battery Production</h2>
          <div class="space-y-5 text-base leading-7 text-slate-300">
            <p>
              Yapai Battery Factory is a professional mobile phone battery manufacturer headquartered in Guangdong, China, with its production plant located in Dongguan.
            </p>
            <p>
              Our factory is equipped with advanced production and testing equipment, with a daily capacity exceeding 5,000 battery packs. We support OEM/ODM orders and offer free brand logo customization.
            </p>
          </div>
          <div class="grid grid-cols-2 gap-4 mt-8">
            <div class="bg-white/5 backdrop-blur-sm p-6 rounded-2xl border border-white/10 hover:bg-white/10 transition-all">
              <div class="text-white font-bold text-3xl mb-1">20+</div>
              <div class="text-sm text-slate-400 uppercase tracking-wider font-semibold">Years Experience</div>
            </div>
            <div class="bg-white/5 backdrop-blur-sm p-6 rounded-2xl border border-white/10 hover:bg-white/10 transition-all">
              <div class="text-white font-bold text-3xl mb-1">100%</div>
              <div class="text-sm text-slate-400 uppercase tracking-wider font-semibold">Quality Inspected</div>
            </div>
            <div class="bg-white/5 backdrop-blur-sm p-6 rounded-2xl border border-white/10 hover:bg-white/10 transition-all">
              <div class="text-white font-bold text-3xl mb-1">30+</div>
              <div class="text-sm text-slate-400 uppercase tracking-wider font-semibold">Battery Models</div>
            </div>
            <div class="bg-white/5 backdrop-blur-sm p-6 rounded-2xl border border-white/10 hover:bg-white/10 transition-all">
              <div class="text-white font-bold text-3xl mb-1">OEM</div>
              <div class="text-sm text-slate-400 uppercase tracking-wider font-semibold">Custom Branding</div>
            </div>
          </div>
        </div>
        <div class="relative reveal-right">
          <div class="grid grid-cols-2 gap-4">
            <div class="aspect-[3/4] rounded-2xl overflow-hidden shadow-xl">
              <%= image_tag "worker3.jpg", class: "w-full h-full object-cover hover:scale-105 transition-transform duration-700" %>
            </div>
            <div class="space-y-4 pt-8">
              <div class="aspect-square rounded-2xl overflow-hidden shadow-xl">
                <%= image_tag "worker1.jpg", class: "w-full h-full object-cover hover:scale-105 transition-transform duration-700" %>
              </div>
              <div class="aspect-square rounded-2xl overflow-hidden shadow-xl">
                <%= image_tag "worker2.jpg", class: "w-full h-full object-cover hover:scale-105 transition-transform duration-700" %>
              </div>
            </div>
          </div>
          <div class="absolute -bottom-6 -left-6 bg-primary p-6 rounded-2xl shadow-xl hidden md:block">
            <p class="text-white font-bold">R&D and Production Team</p>
            <p class="text-white/70 text-sm">Professional & Dedicated</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== PRODUCTION AND CUSTOMIZATION CAPABILITIES (from about us) ===== -->
  <div class="py-24 bg-white overflow-hidden relative z-10 -mt-12 rounded-t-[4rem] shadow-[0_-30px_60px_rgba(0,0,0,0.02)]">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
        <div class="lg:col-span-5 space-y-8">
          <div>
            <h2 class="text-4xl font-black text-slate-900 mb-8 tracking-tight"><%= t('home.about.heritage_title') %></h2>
            <div class="space-y-6">
              <p class="text-slate-600 text-lg leading-relaxed font-medium">
                <%= t('home.about.heritage_desc_1') %>
              </p>
              <p class="text-slate-600 text-lg leading-relaxed font-medium border-l-4 border-primary pl-6 py-2 bg-slate-50 rounded-r-2xl">
                <%= t('home.about.heritage_desc_2') %>
              </p>
            </div>
          </div>
          
          <div class="grid grid-cols-2 gap-6 pt-4">
            <div class="p-8 bg-slate-50 rounded-[2rem] border border-slate-100 group hover:bg-white hover:shadow-2xl hover:border-primary/20 transition-all duration-500">
              <div class="text-primary font-black text-4xl mb-3">1,000+</div>
              <p class="text-sm font-bold text-slate-500 uppercase tracking-widest"><%= t('home.about.stats.years') %></p>
            </div>
            <div class="p-8 bg-slate-50 rounded-[2rem] border border-slate-100 group hover:bg-white hover:shadow-2xl hover:border-secondary/20 transition-all duration-500">
              <div class="text-secondary font-black text-4xl mb-3">5,000+</div>
              <p class="text-sm font-bold text-slate-500 uppercase tracking-widest"><%= t('home.about.stats.subsidiaries') %></p>
            </div>
          </div>
        </div>
        
        <div class="lg:col-span-7 relative group">
          <div class="aspect-[16/10] lg:aspect-[16/9] rounded-[4rem] overflow-hidden shadow-[0_32px_64px_-16px_rgba(0,0,0,0.1)] transition-transform duration-700 group-hover:scale-[1.02]">
            <%= image_tag "global.jpg", class: "w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110", alt: "Yapai Factory" %>
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          </div>
          <!-- Decorative elements -->
          <div class="absolute -bottom-12 -left-12 w-64 h-64 bg-primary/10 rounded-full blur-3xl -z-10 animate-pulse"></div>
          <div class="absolute -top-12 -right-12 w-64 h-64 bg-slate-200/50 rounded-full blur-3xl -z-10"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== SECOND MARQUEE (reverse) ===== -->
  <div class="bg-slate-50 py-12 overflow-hidden border-y border-slate-100">
    <div class="flex gap-6" style="animation: marquee-strip-reverse 35s linear infinite; width: max-content;">
      <% 2.times do %>
        <%= image_tag "factory5.jpg", class: "h-44 w-72 object-cover rounded-2xl flex-shrink-0 shadow-md transition-all duration-500" %>
        <%= image_tag "factory4.jpg", class: "h-44 w-72 object-cover rounded-2xl flex-shrink-0 shadow-md transition-all duration-500" %>
        <%= image_tag "factory3.jpg", class: "h-44 w-72 object-cover rounded-2xl flex-shrink-0 shadow-md transition-all duration-500" %>
        <%= image_tag "factory2.jpg", class: "h-44 w-72 object-cover rounded-2xl flex-shrink-0 shadow-md transition-all duration-500" %>
        <%= image_tag "factory1.jpg", class: "h-44 w-72 object-cover rounded-2xl flex-shrink-0 shadow-md transition-all duration-500" %>
      <% end %>
    </div>
  </div>

  <!-- Featured Products — Carousel (from about us) -->
  <div class="py-24 bg-slate-50 overflow-hidden relative z-10 -mt-16 rounded-t-[4rem] shadow-[0_-20px_40px_rgba(0,0,0,0.03)] border-t border-slate-100">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="text-3xl font-black text-slate-900 tracking-tight">Featured Products</h2>
        <p class="mt-4 text-slate-500 font-medium">Crafted with Precision</p>
      </div>

      <div
        x-data="{
          current: 0,
          total: <%= @featured_categories.count %>,
          perPage: 3,
          autoTimer: null,
          get maxIndex() { return Math.max(0, this.total - this.perPage); },
          next() { this.current = this.current >= this.maxIndex ? 0 : this.current + 1; },
          prev() { this.current = this.current <= 0 ? this.maxIndex : this.current - 1; },
          startAuto() { this.autoTimer = setInterval(() => this.next(), 4000); },
          stopAuto() { clearInterval(this.autoTimer); }
        }"
        x-init="
          const updatePerPage = () => {
            if (window.innerWidth < 768) perPage = 1;
            else if (window.innerWidth < 1024) perPage = 2;
            else perPage = 3;
          };
          updatePerPage();
          window.addEventListener('resize', () => { updatePerPage(); current = 0; });
          startAuto();
        "
        @mouseenter="stopAuto()"
        @mouseleave="startAuto()"
        class="relative"
      >
        <!-- Carousel track -->
        <div class="overflow-hidden">
          <div
            class="flex transition-transform duration-700 ease-in-out gap-6"
            :style="`transform: translateX(calc(-${current} * (100% / ${perPage} + 24px / ${perPage})))`"
          >
            <% @featured_categories.each do |category| %>
              <div class="flex-shrink-0 w-full md:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)]">
                <%= link_to category_path(category), class: "block bg-white rounded-[2.5rem] border border-slate-100 shadow-sm hover:shadow-2xl hover:border-primary/20 transition-all duration-500 overflow-hidden group" do %>
                  <div class="relative h-64 bg-slate-50 overflow-hidden">
                    <% if category.image.attached? %>
                      <%= image_tag rails_storage_proxy_path(category.image.variant(:featured)),
                            class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000",
                            alt: category.name %>
                    <% else %>
                      <div class="w-full h-full flex items-center justify-center bg-slate-100">
                        <svg class="w-12 h-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                      </div>
                    <% end %>
                    <div class="absolute top-4 left-4">
                      <span class="px-3 py-1 bg-primary/90 backdrop-blur-sm text-white text-[10px] font-black uppercase tracking-widest rounded-full shadow-lg">
                        Featured
                      </span>
                    </div>
                  </div>
                  <div class="p-8 text-center bg-white">
                    <h3 class="text-xl font-black text-slate-900 group-hover:text-primary transition-colors duration-300"><%= category.name %></h3>
                    <p class="text-[10px] text-slate-400 font-bold uppercase tracking-[0.2em] mt-2 flex items-center justify-center gap-2">
                      <span class="w-4 h-[1px] bg-slate-200"></span>
                      Custom · OEM · ODM
                      <span class="w-4 h-[1px] bg-slate-200"></span>
                    </p>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <% if @featured_categories.count > 1 %>
          <!-- Arrows -->
          <button @click="prev()" class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 md:-translate-x-6 w-12 h-12 bg-white border border-slate-100 rounded-full shadow-xl flex items-center justify-center text-slate-400 hover:bg-primary hover:text-white hover:border-primary transition-all duration-300 z-10 group/btn">
            <svg class="w-6 h-6 transform group-hover/btn:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
          </button>
          <button @click="next()" class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 md:translate-x-6 w-12 h-12 bg-white border border-slate-100 rounded-full shadow-xl flex items-center justify-center text-slate-400 hover:bg-primary hover:text-white hover:border-primary transition-all duration-300 z-10 group/btn">
            <svg class="w-6 h-6 transform group-hover/btn:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
          </button>

          <!-- Dots -->
          <div class="flex justify-center gap-3 mt-12">
            <template x-for="i in Math.max(0, total - perPage + 1)" :key="i">
              <button
                @click="current = i - 1"
                :class="current === i - 1 ? 'bg-primary w-8' : 'bg-slate-200 w-2 hover:bg-slate-300'"
                class="h-2 rounded-full transition-all duration-500"
              ></button>
            </template>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- ===== YAPAI-ABILITIES ===== -->
  <div class="relative bg-slate-900 py-24 sm:py-32 overflow-hidden -mt-16 z-10 rounded-t-[4rem]">
    <div class="absolute inset-0 opacity-10">
      <%= image_tag "factory5.jpg", class: "w-full h-full object-cover" %>
    </div>
    <div class="absolute top-0 left-0 w-full h-24 bg-gradient-to-b from-black/20 to-transparent"></div>
    <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
      <div class="text-center mb-16 reveal-up">
        <p class="text-primary font-semibold tracking-widest uppercase text-sm mb-3">What We Offer</p>
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Full-Service Manufacturing</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% [
          { title: "Diverse Battery Portfolio", color: "primary", desc: "Replacement batteries for iPhone, Samsung, Huawei, Xiaomi, Vivo, Oppo, and more.", items: ["iPhone Batteries", "Samsung Batteries", "Huawei Batteries", "Xiaomi Batteries", "Vivo & Oppo", "Redmi & Honor"] },
          { title: "Global Reach", color: "secondary", desc: "Products exported to Europe, America, Southeast Asia, Middle East, and Latin America.", items: ["United States", "Germany", "United Kingdom", "Russia", "Brazil", "India"] },
          { title: "Custom Services", color: "accent", desc: "End-to-end customization from cell choice to private labeling and packaging design.", items: ["Custom Capacity", "Private Labeling", "Packaging Design", "BMS Customization", "OEM / ODM", "Small Batch Orders"] }
        ].each do |yapai| %>
          <div class="reveal-card bg-white/5 backdrop-blur-md rounded-3xl border border-white/10 overflow-hidden shadow-sm hover:shadow-xl hover:bg-white/10 transition-all duration-300">
            <div class="h-2 bg-<%= yapai[:color] %>"></div>
            <div class="p-8">
              <h3 class="text-xl font-bold text-white mb-3"><%= yapai[:title] %></h3>
              <p class="text-slate-400 text-sm leading-relaxed mb-6"><%= yapai[:desc] %></p>
              <ul class="space-y-2">
                <% yapai[:items].each do |item| %>
                  <li class="flex items-center gap-2 text-sm text-slate-300">
                    <svg class="w-4 h-4 text-<%= yapai[:color] %> flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                    </svg>
                    <%= item %>
                  </li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Partners Section (from about us) -->
  <% if @partners.present? %>
    <div class="py-24 bg-white overflow-hidden border-t border-slate-100 relative z-20 -mt-12 rounded-t-[4rem]">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="text-center mb-16 reveal-up">
          <p class="text-primary font-semibold tracking-widest uppercase text-sm mb-3"><%= t('home.about.partners.subtitle') %></p>
          <h2 class="text-3xl font-black text-slate-900 tracking-tight"><%= t('home.about.partners.title') %></h2>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8 items-center justify-items-center">
          <% @partners.each do |partner| %>
            <div class="w-full max-w-[200px] h-32 flex items-center justify-center p-6 transition-all duration-500 hover:scale-110 reveal-up">
              <% if partner.logo.attached? %>
                <%= image_tag partner.logo, class: "max-w-full max-h-full object-contain", alt: partner.name %>
              <% else %>
                <span class="text-slate-300 font-bold"><%= partner.name %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>


  <!-- ===== VISIT US / CTA ===== -->
  <div class="py-24 sm:py-32 bg-white relative z-20 -mt-16 rounded-t-[4rem] shadow-[0_-30px_60px_rgba(0,0,0,0.05)]">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="bg-white border border-slate-100 rounded-[3rem] overflow-hidden shadow-2xl flex flex-col lg:flex-row reveal-up">
        <div class="p-12 lg:p-16 lg:w-3/5">
          <p class="text-primary font-semibold tracking-widest uppercase text-sm mb-3">Open Door Policy</p>
          <h2 class="text-3xl font-bold tracking-tight text-slate-900 mb-6">Visit Our Factory</h2>
          <p class="text-slate-500 text-lg mb-8">
            We welcome all partners to visit our factory in Dongguan. Come see our production lines, meet our team, and discuss your order requirements in person. Let's build a long-term partnership together.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-10">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 bg-secondary/10 rounded-full flex items-center justify-center flex-shrink-0">
